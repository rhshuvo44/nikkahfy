# ---------------------------------------------------------------------------
# NIKKAHFY — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Canonical public origin of the deployment. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database — MongoDB + Mongoose (never Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
# Atlas example:
#   MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nikkahfy?retryWrites=true&w=majority"
# Local example:
#   MONGODB_URI="mongodb://127.0.0.1:27017/nikkahfy"
MONGODB_URI="mongodb://127.0.0.1:27017/nikkahfy"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Openssl equivalent: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Cloudinary — gallery + gift images + optional background music upload
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Seed script (`npm run seed`) — creates/updates the single SUPER_ADMIN user.
# There is no public "become admin" flow; never reuse these values elsewhere.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Nikkahfy Admin"
